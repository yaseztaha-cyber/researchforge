# --- Database ---
# Use PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://researchforge:changeme@localhost:5432/researchforge
# Local dev defaults to SQLite (no Docker required).
DATABASE_URL=sqlite:///./researchforge.db

# --- LLM (provider abstraction; all optional for mock/dev mode) ---
# Set LLM_PROVIDER=mock for deterministic offline development (default).
LLM_PROVIDER=mock
# For a real model use LLM_PROVIDER=api with an OpenAI-compatible endpoint:
# LLM_PROVIDER=api
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=hash-384
EMBEDDING_PROVIDER=hash

# --- Retrieval ---
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_API_URL=

# --- Research loop limits ---
MAX_SEARCH_ROUNDS=2
MAX_SOURCES=12
MAX_RELEVANT_SOURCES=6
MAX_COST_PER_RESEARCH=2.00
RESEARCH_TIMEOUT_SECONDS=300

# --- Misc ---
MOCK_MODE=true
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
